# Neon Postgres connection string
DATABASE_URL=

# Optional secret to protect the cron endpoint.
# Vercel sets Authorization: Bearer <CRON_SECRET> on scheduled invocations.
CRON_SECRET=

# Optional override for the RSS-Bridge instance.
# Defaults to https://rss-bridge.org/bridge01 if unset.
# RSS_BRIDGE_URL=https://rss-bridge.org/bridge01
